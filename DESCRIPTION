Package: surveywts
Title: Tools for Survey Weighting and Calibration
Version: 0.2.0.9000
Authors@R:
    person(
        "Jacob", "Dennen",
        email = "jdenn0514@gmail.com",
        role = c("aut", "cre", "cph"),
        comment = c(ORCID = "0000-0003-3006-7364")
